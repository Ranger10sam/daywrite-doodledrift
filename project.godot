; DoodleDrift — A little adventure by Daywrite.
config_version=5

[application]
config/name="DoodleDrift"
config/description="A little adventure by Daywrite. A tiny ball. A world of possibilities. Draw your way forward."
; Pin the previous desktop save directory despite the new public name.
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Momentum Quest"
config/custom_user_dir_name.linux="godot/app_userdata/Momentum Quest"
config/version="1.0.0"
run/main_scene="res://scenes/core/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
boot_splash/bg_color=Color(1, 0.976, 0.941, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/splash.png"
boot_splash/use_filter=true

[autoload]
SaveManager="*res://scripts/persistence/save_manager.gd"
AudioManager="*res://scripts/managers/audio_manager.gd"
Entitlements="*res://scripts/managers/entitlements.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(1, 0.976, 0.941, 1)

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true
2d/default_gravity=1100.0

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[layer_names]
2d_physics/layer_1="Terrain"
2d_physics/layer_2="Player"
2d_physics/layer_3="Drawings"
2d_physics/layer_4="Moving platforms"
2d_physics/layer_5="Triggers"

[audio]
driver/enable_input=false
